<Window x:Class="PlantGenealogy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="شجرة النسب النباتية" Height="980" Width="1500" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft">
    <Grid Background="#F8F4EC">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="12" Background="#F5F1E9" BorderBrush="#D9B866" BorderThickness="3" CornerRadius="22">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="TreeCanvas" Width="1500" Height="1200" Background="#F5F1E9" />
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Margin="12" Background="#FFFDF9" BorderBrush="#D9B866" BorderThickness="2" CornerRadius="18" Padding="18">
            <StackPanel>
                <TextBlock Text="إدارة شجرة النسب" FontSize="26" FontWeight="Bold" Foreground="#1F6A45" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                <TextBlock Text="اسم الشخص" FontWeight="SemiBold" Margin="0,6,0,3"/>
                <TextBox x:Name="NameTextBox" Height="36" Margin="0,0,0,12"/>

                <TextBlock Text="العنوان/اللقب" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="TitleTextBox" Height="36" Margin="0,0,0,12"/>

                <TextBlock Text="ملاحظات" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="NotesTextBox" Height="90" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14"/>

                <TextBlock Text="الشخص المحدد" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="SelectedNodeText" Text="لا يوجد" Foreground="#5D5D5D" Margin="0,0,0,12"/>

                <Button x:Name="AddRootButton" Content="إضافة جذر جديد" Height="42" Margin="0,0,0,8" Background="#D7AF5D" Foreground="White" FontWeight="Bold" Click="AddRootButton_Click"/>
                <Button x:Name="AddChildButton" Content="إضافة فرع تحت المحدد" Height="42" Margin="0,0,0,8" Background="#2F8F5A" Foreground="White" FontWeight="Bold" Click="AddChildButton_Click"/>
                <Button x:Name="UpdateButton" Content="تحديث الشخص المحدد" Height="42" Margin="0,0,0,8" Background="#1F6A45" Foreground="White" FontWeight="Bold" Click="UpdateButton_Click"/>
                <Button x:Name="DeleteButton" Content="حذف الشخص وفروعه" Height="42" Margin="0,0,0,8" Background="#A7403D" Foreground="White" FontWeight="Bold" Click="DeleteButton_Click"/>
                <Button x:Name="ClearButton" Content="مسح الحقول" Height="42" Margin="0,0,0,16" Background="#F0E6D1" Foreground="#5A3C23" FontWeight="Bold" Click="ClearButton_Click"/>

                <TextBlock Text="ملاحظات التطبيق" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="يتم حفظ البيانات داخل SQLite في مجلد المستخدم المحلي، ويمكن التعديل وإضافة الفروع مباشرة من الشجرة." TextWrapping="Wrap" Foreground="#5C5C5C" LineHeight="22"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
